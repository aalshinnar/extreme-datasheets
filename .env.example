# Server Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/extreme-datasheets

# JWT Configuration
JWT_SECRET=your-super-secret-key-min-32-characters-long-secure-string
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters-long-secure-string
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Email Service Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@extremenetworks.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# File Storage
STORAGE_TYPE=local
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Security
CORS_ORIGIN=http://localhost:3000
API_RATE_LIMIT=100

# AWS S3 (for production)
# S3_BUCKET=extreme-datasheets
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret

# Logging
LOG_LEVEL=info
